CC497B231953D0161A5AB94D422/B99807CE3A35C3FE08B11A9B41AC03AAED2F3A1F.PNG","g":"default","e":false,"at":null,"r":21.3,"h":true},{"id":18,"n":"In Need of Assistance","d":"Heedless of the warning, the burly seals spread out as they swim, until the spell around them weakens and they become human once more.","t":"silver","i":"https://image.api.playstation.com/trophy/np/NPWR13664_00_0043A76295BEB3DCC497B231953D0161A5AB94D422/313AF44F290F170A7A86F9FB0873595948BF88C7.PNG","g":"default","e":false,"at":null,"r":27.7,"h":true},{"id":19,"n":"Poor Beastie","d":"With a piercing screech, the creature disappears back into the depths.","t":"silver","i":"https://image.api.playstation.com/trophy/np/NPWR13664_00_0043A76295BEB3DCC497B231953D0161A5AB94D422/D7E27A4115C9E2DB4A06CCBE4967CF82E3DFB242.PNG","g":"default","e":false,"at":null,"r":22.0,"h":true},{"id":20,"n":"Foiled by the Tree","d":"The jaws snap shut over the shattered tree, launching the men out into the deepening darkness.","t":"silver","i":"https://image.api.playstation.com/trophy/np/NPWR13664_00_0043A76295BEB3DCC497B231953D0161A5AB94D422/1C90B000BC621E78B77B9DA81F7CED131D93F06A.PNG","g":"default","e":false,"at":null,"r":21.3,"h":true},{"id":21,"n":"She's a Goner","d":"Clinging to wooden barrels, they watch their beloved ship sink into the depths.","t":"silver","i":"https://image.api.playstation.com/trophy/np/NPWR13664_00_0043A76295BEB3DCC497B231953D0161A5AB94D422/8B03FD868FE205E1463C880D5225D5BF2238D96A.PNG","g":"default","e":false,"at":null,"r":22.7,"h":true},{"id":22,"n":"Womenfolk in the Water","d":"Finding the dark water empty, the men quickly regret their course of action.","t":"silver","i":"https://image.api.playstation.com/trophy/np/NPWR13664_00_0043A76295BEB3DCC497B231953D0161A5AB94D422/F7E7016A60EF7BA754A5F13B6E9860E4040A0737.PNG","g":"default","e":true,"at":"2020-04-16T20:48:42+00:00","r":30.1,"h":true},{"id":23,"n":"Well Met…","d":"“Er, hullo,” stammers Brave Beard.","t":"gold","i":"https://image.api.playstation.